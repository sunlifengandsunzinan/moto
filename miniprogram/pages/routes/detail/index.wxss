.route-detail-reference-page {
  padding-top: 2rpx;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  color: #1f1f1f;
}

.route-detail-kpi-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 2rpx solid #131313;
  background: #fff;
  margin-bottom: 16rpx;
}

.route-detail-kpi-item {
  min-height: 96rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  border-right: 2rpx solid #131313;
}

.route-detail-kpi-item:last-child {
  border-right: 0;
}

.route-detail-kpi-item__label {
  font-size: 22rpx;
  color: #666;
  font-weight: 400;
}

.route-detail-kpi-item__value {
  font-size: 22rpx;
  color: #111;
  font-weight: 600;
}

.route-overview-title {
  font-size: 34rpx;
  color: #111;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 10rpx;
}

.route-map-panel {
  position: relative;
  border: 2rpx solid #181818;
  background: #fff;
  overflow: hidden;
}

.route-detail-map {
  width: 100%;
  height: 520rpx;
  display: block;
}

.route-detail-map--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
}

.route-map-panel__cta {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  min-width: 220rpx;
  padding: 0 18rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffb133;
  box-sizing: border-box;
}

.route-map-panel__cta-text {
  color: #2f2208;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0;
}

.route-map-panel__hint {
  padding: 10rpx 14rpx 14rpx;
  background: #faf6ef;
  border-top: 1rpx solid #eee1cd;
}

.route-map-panel__hint-text {
  color: #6c5631;
  font-size: 19rpx;
  line-height: 1.4;
}

.route-import-helper-entry {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
}

.route-import-helper-entry__button {
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #2d2d2d;
  background: #fff;
  border: 2rpx solid #e5e5e5;
}

.route-import-helper-entry__button::after {
  border: 0;
}

.route-detail-actions-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin: 14rpx 0 20rpx;
}

.route-detail-action-button {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.route-detail-favorite-button {
  background: rgba(209, 170, 130, 0.18);
}

.route-detail-want-go-button {
  background: #f4efe7;
  border-color: #c39a5a;
  color: #5a3d15;
}

.route-detail-favorite-button--active {
  background: #4f4a46;
  color: #fbf7f0;
}

.checkpoint-list {
  background: #fff;
}

.checkpoint-item {
  display: grid;
  grid-template-columns: 46rpx 1fr;
  gap: 14rpx;
  padding: 16rpx 0;
}

.checkpoint-left {
  display: flex;
  position: relative;
  justify-content: center;
}

.checkpoint-meta-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

.checkpoint-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid #0f0f0f;
  background: #fff;
  z-index: 1;
}

.checkpoint-dot--checked {
  background: #ffb133;
  border-color: #be7d1f;
}

.checkpoint-line {
  position: absolute;
  top: 28rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #dedede;
}

.checkpoint-main {
  border-bottom: 2rpx solid #ececec;
  padding-bottom: 14rpx;
}

.checkpoint-title-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
}

.checkpoint-index {
  font-size: 24rpx;
  line-height: 1.3;
  color: #222;
  font-weight: 500;
}

.checkpoint-name-row {
  margin-top: 4rpx;
}

.checkpoint-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.28;
  color: #111;
  font-weight: 700;
}

.checkpoint-hit {
  font-size: 24rpx;
  color: #202020;
  font-weight: 500;
}

.checkpoint-score {
  display: block;
  margin-top: 6rpx;
  color: #7d7d7d;
  font-size: 22rpx;
  font-weight: 400;
}

.checkpoint-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.checkpoint-checkin-button {
  margin: 0;
  min-height: 40rpx;
  line-height: 40rpx;
  border-radius: 999rpx;
  padding: 0 14rpx;
  font-size: 18rpx;
  color: #6a3f07;
  border: 2rpx solid #cf9a58;
  background: #fff7eb;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
}

.checkpoint-checkin-button::after {
  border: 0;
}

.checkpoint-checkin-button__icon {
  display: inline-block;
  width: 20rpx;
  height: 20rpx;
  line-height: 20rpx;
  text-align: center;
  font-size: 16rpx;
  border-radius: 999rpx;
  background: rgba(207, 154, 88, 0.16);
}

.checkpoint-checkin-button__label {
  font-size: 18rpx;
  line-height: 1;
}

.checkpoint-checkin-button--done {
  color: #63705b;
  border-color: #b7c6aa;
  background: #eff6e7;
}

.checkpoint-checkin-button--done .checkpoint-checkin-button__icon {
  background: rgba(124, 156, 99, 0.18);
}

.checkpoint-distance,
.checkpoint-duration {
  color: #4a4a4a;
  font-size: 20rpx;
  font-weight: 400;
}

.linked-spots-section {
  margin-top: 22rpx;
}

.linked-spots-section__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1b1b1b;
  margin-bottom: 10rpx;
}

.linked-spots-list {
  display: grid;
  gap: 14rpx;
}

.linked-spot-card {
  border: 2rpx solid #e8e8e8;
  background: #fff;
}

.linked-spot-card__image {
  width: 100%;
  height: 260rpx;
  display: block;
}

.linked-spot-card__body {
  padding: 14rpx;
}

.linked-spot-card__name {
  font-size: 30rpx;
  color: #111;
  font-weight: 700;
}

.linked-spot-card__summary {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.45;
  color: #3f3f3f;
}

.linked-spot-card__coordinates {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4c4c4c;
}

.linked-spot-card__tags {
  margin-top: 10rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.linked-spot-card__tag {
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d7d7d7;
  font-size: 20rpx;
  color: #303030;
}

.linked-spot-card__sources {
  margin-top: 10rpx;
}

.linked-spot-card__sources-title {
  font-size: 21rpx;
  color: #636363;
  margin-bottom: 4rpx;
}

.linked-spot-card__source-item {
  font-size: 21rpx;
  line-height: 1.5;
  color: #2e2e2e;
}

.route-import-modal {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.36);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.route-import-modal__dialog {
  width: 100%;
  max-height: 82vh;
  background: #fff;
  border-top-left-radius: 26rpx;
  border-top-right-radius: 26rpx;
  padding: 22rpx;
  box-sizing: border-box;
  overflow-y: auto;
}

.route-import-modal__header {
  display: grid;
  gap: 6rpx;
}

.route-import-modal__title {
  font-size: 33rpx;
  font-weight: 700;
  color: #111;
}

.route-import-modal__subtitle {
  font-size: 22rpx;
  color: #595959;
}

.route-import-modal__status {
  margin-top: 14rpx;
  padding: 12rpx 14rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.route-import-modal__status--success {
  background: #ecf8ee;
  color: #196127;
}

.route-import-modal__status--failed {
  background: #fdf0ee;
  color: #8a2f22;
}

.route-import-modal__apps {
  margin-top: 14rpx;
  display: grid;
  gap: 10rpx;
}

.route-import-modal__app {
  border: 2rpx solid #e4e4e4;
  border-radius: 14rpx;
  padding: 12rpx;
}

.route-import-modal__app.is-active {
  border-color: #1d6c99;
  background: #f2f8fc;
}

.route-import-modal__app-label {
  display: block;
  font-size: 25rpx;
  color: #1c1c1c;
  font-weight: 600;
}

.route-import-modal__app-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #606060;
}

.route-import-modal__steps,
.route-import-modal__troubleshooting {
  margin-top: 14rpx;
}

.route-import-modal__steps-title {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 8rpx;
}

.route-import-modal__step-item {
  display: flex;
  gap: 8rpx;
  margin-top: 6rpx;
}

.route-import-modal__step-index,
.route-import-modal__step-text,
.route-import-modal__troubleshooting-item {
  font-size: 22rpx;
  line-height: 1.55;
  color: #2e2e2e;
}

.route-import-modal__actions {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
}

.route-import-modal__btn {
  min-height: 68rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.route-import-modal__btn::after {
  border: 0;
}

.route-import-modal__btn--ghost {
  border: 2rpx solid #d7d7d7;
  color: #2c2c2c;
  background: #fff;
}

.route-import-modal__btn--primary {
  background: #ffb133;
  color: #2f2208;
}

@media (max-width: 640rpx) {
  .route-detail-kpi-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .route-detail-kpi-item {
    border-right: 0;
    border-bottom: 2rpx solid #131313;
  }

  .route-detail-kpi-item:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
}
