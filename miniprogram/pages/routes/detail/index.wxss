.route-detail-page {
  padding-bottom: 32rpx;
}

.route-detail-section-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #47413C;
}

.route-detail-shot-image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 24rpx;
  border: 2rpx solid rgba(91, 83, 77, 0.1);
  background: #EEF2F5;
}

.route-detail-shot-placeholder {
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #EEF2F5;
}

.route-stage-list-detail {
  gap: 18rpx;
}

.route-stage-item-detail {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 16rpx;
  align-items: start;
}

.route-stage-day-detail {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #4F4A46;
  color: #FBF7F0;
  font-size: 24rpx;
  box-sizing: border-box;
}

.route-stage-track-detail {
  display: grid;
  grid-template-columns: 18rpx 1fr;
  gap: 16rpx;
}

.route-stage-marker-detail {
  width: 18rpx;
  min-height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #D1AA82 0 16%, #5B534D 16% 34%, #F7EFE4 34% 52%, #5B534D 52% 70%, #D1AA82 70% 100%);
}

.route-day-card-detail {
  padding: 2rpx 0;
}

.route-day-tag-row {
  margin: 10rpx 0 0;
}

.route-stage-title-detail {
  color: #4A433E;
  line-height: 1.5;
  font-size: 28rpx;
  font-weight: 700;
}

.route-detail-gpx-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.route-detail-gpx-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.route-detail-gpx-title {
  color: #4A433E;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
}

.route-detail-gpx-strip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.route-detail-gpx-strip-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(247, 239, 228, 0.86);
  box-sizing: border-box;
}

.route-detail-gpx-strip-item__label {
  flex: none;
  color: #8B8177;
  font-size: 22rpx;
}

.route-detail-gpx-strip-item__value {
  color: #4A433E;
  font-size: 22rpx;
  line-height: 1.45;
}

.route-detail-gpx-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.route-detail-action-button {
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}
