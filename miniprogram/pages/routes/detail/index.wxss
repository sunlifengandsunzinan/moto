.route-detail-reference-page {
  padding-top: 2rpx;
  font-family: "PingFang SC", "Helvetica Neue", Arial, sans-serif;
  color: #1f1f1f;
}

.route-detail-kpi-strip {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border: 2rpx solid #131313;
  background: #fff;
  margin-bottom: 16rpx;
}

.route-detail-kpi-item {
  min-height: 96rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 0;
  border-right: 2rpx solid #131313;
}

.route-detail-kpi-item:last-child {
  border-right: 0;
}

.route-detail-kpi-item__label {
  font-size: 22rpx;
  color: #666;
  font-weight: 400;
}

.route-detail-kpi-item__value {
  font-size: 22rpx;
  color: #111;
  font-weight: 600;
}

.route-overview-title {
  font-size: 34rpx;
  color: #111;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 10rpx;
}

.route-map-panel {
  position: relative;
  border: 2rpx solid #181818;
  background: #fff;
  overflow: hidden;
}

.route-detail-map {
  width: 100%;
  height: 520rpx;
  display: block;
}

.route-detail-map--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #666;
}

.route-map-panel__cta {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  width: 200rpx;
  height: 46rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffb133;
  box-sizing: border-box;
}

.route-map-panel__cta-text {
  color: #2f2208;
  font-size: 17rpx;
  line-height: 1;
  font-weight: 600;
  letter-spacing: 0;
}

.route-detail-actions-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
  margin: 14rpx 0 20rpx;
}

.route-detail-action-button {
  min-height: 64rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.route-detail-favorite-button {
  background: rgba(209, 170, 130, 0.18);
}

.route-detail-favorite-button--active {
  background: #4f4a46;
  color: #fbf7f0;
}

.checkpoint-list {
  background: #fff;
}

.checkpoint-item {
  display: grid;
  grid-template-columns: 46rpx 1fr;
  gap: 14rpx;
  padding: 16rpx 0;
}

.checkpoint-left {
  position: relative;
  display: flex;
  justify-content: center;
}

.checkpoint-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 12rpx;
  border-radius: 999rpx;
  border: 2rpx solid #0f0f0f;
  background: #fff;
  z-index: 1;
}

.checkpoint-line {
  position: absolute;
  top: 28rpx;
  bottom: -16rpx;
  width: 2rpx;
  background: #dedede;
}

.checkpoint-main {
  border-bottom: 2rpx solid #ececec;
  padding-bottom: 14rpx;
}

.checkpoint-title-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  align-items: center;
}

.checkpoint-index {
  font-size: 24rpx;
  line-height: 1.3;
  color: #222;
  font-weight: 500;
}

.checkpoint-name-row {
  margin-top: 4rpx;
}

.checkpoint-title {
  display: block;
  font-size: 42rpx;
  line-height: 1.28;
  color: #111;
  font-weight: 700;
}

.checkpoint-hit {
  font-size: 24rpx;
  color: #202020;
  font-weight: 500;
}

.checkpoint-score {
  display: block;
  margin-top: 6rpx;
  color: #7d7d7d;
  font-size: 22rpx;
  font-weight: 400;
}

.checkpoint-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-top: 6rpx;
}

.checkpoint-distance,
.checkpoint-duration {
  color: #4a4a4a;
  font-size: 20rpx;
  font-weight: 400;
}

@media (max-width: 640rpx) {
  .route-detail-kpi-strip {
    grid-template-columns: repeat(2, 1fr);
  }

  .route-detail-kpi-item {
    border-right: 0;
    border-bottom: 2rpx solid #131313;
  }

  .route-detail-kpi-item:nth-last-child(-n + 2) {
    border-bottom: 0;
  }
}
