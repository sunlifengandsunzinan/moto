.route-detail-page {
  padding-bottom: 32rpx;
}

.route-detail-heat-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.route-detail-heat-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 113, 67, 0.14);
  color: #B4491A;
  box-sizing: border-box;
}

.route-detail-heat-pill__icon,
.route-detail-heat-pill__count {
  font-size: 22rpx;
  font-weight: 700;
}

.route-detail-heat-meta {
  font-size: 22rpx;
  color: #8A7A6B;
}

.route-detail-section-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #47413C;
}

.route-detail-shot-image {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 24rpx;
  border: 2rpx solid rgba(91, 83, 77, 0.1);
  background: #EEF2F5;
}

.route-detail-map-shell {
  overflow: hidden;
  min-height: 620rpx;
  border-radius: 24rpx;
  border: 2rpx solid rgba(91, 83, 77, 0.1);
  background: linear-gradient(180deg, #f6efe5 0%, #efe4d5 100%);
}

.route-detail-map {
  width: 100%;
  height: 620rpx;
}

.route-detail-map-placeholder {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 320rpx;
  padding: 36rpx 32rpx;
  justify-content: center;
  border-radius: 24rpx;
  border: 2rpx solid rgba(91, 83, 77, 0.1);
  background: linear-gradient(180deg, rgba(246, 239, 229, 0.95) 0%, rgba(239, 228, 213, 0.92) 100%);
}

.route-detail-map-placeholder__title {
  color: #4A433E;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.route-detail-map-placeholder__copy {
  line-height: 1.6;
}

.route-detail-map-inline-actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.route-detail-map-primary-action {
  background: rgba(209, 170, 130, 0.2);
}

.route-detail-shot-placeholder {
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #EEF2F5;
}

.route-stage-list-detail {
  gap: 18rpx;
}

.route-stage-item-detail {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 16rpx;
  align-items: start;
}

.route-stage-day-detail {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #4F4A46;
  color: #FBF7F0;
  font-size: 24rpx;
  box-sizing: border-box;
}

.route-stage-track-detail {
  display: grid;
  grid-template-columns: 18rpx 1fr;
  gap: 16rpx;
}

.route-stage-marker-detail {
  width: 18rpx;
  min-height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #D1AA82 0 16%, #5B534D 16% 34%, #F7EFE4 34% 52%, #5B534D 52% 70%, #D1AA82 70% 100%);
}

.route-day-card-detail {
  padding: 2rpx 0;
}

.route-day-tag-row {
  margin: 10rpx 0 0;
}

.route-stage-title-detail {
  color: #4A433E;
  line-height: 1.5;
  font-size: 28rpx;
  font-weight: 700;
}

.route-detail-gpx-card {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.route-detail-gpx-badges {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.route-detail-source-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(209, 170, 130, 0.22);
  color: #7A5C3C;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.route-detail-gpx-copy {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.route-detail-gpx-title {
  color: #4A433E;
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 700;
}

.route-detail-gpx-strip-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.route-detail-gpx-strip-item {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  max-width: 100%;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(247, 239, 228, 0.86);
  box-sizing: border-box;
}

.route-detail-gpx-strip-item__label {
  flex: none;
  color: #8B8177;
  font-size: 22rpx;
}

.route-detail-gpx-strip-item__value {
  color: #4A433E;
  font-size: 22rpx;
  line-height: 1.45;
}

.route-detail-gpx-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.route-detail-advice-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  border: 2rpx solid rgba(209, 170, 130, 0.22);
  background: linear-gradient(180deg, rgba(250, 244, 235, 0.96) 0%, rgba(246, 237, 225, 0.98) 100%);
}

.route-detail-advice-header {
  align-items: flex-start;
}

.route-detail-advice-source {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(79, 74, 70, 0.08);
  color: #6E6258;
  font-size: 20rpx;
}

.route-detail-advice-hero {
  position: relative;
  padding: 12rpx 18rpx 12rpx 30rpx;
  border-radius: 24rpx;
  background: rgba(255, 251, 245, 0.84);
}

.route-detail-advice-quote {
  position: absolute;
  left: 12rpx;
  top: 4rpx;
  color: #D1AA82;
  font-size: 48rpx;
  line-height: 1;
}

.route-detail-advice-comment {
  color: #4A433E;
  font-size: 26rpx;
  line-height: 1.7;
  font-weight: 600;
}

.route-detail-advice-list {
  gap: 12rpx;
}

.route-detail-advice-item {
  display: grid;
  grid-template-columns: 16rpx 1fr;
  gap: 12rpx;
  align-items: start;
}

.route-detail-advice-item__dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #D1AA82;
}

.route-detail-advice-item__text {
  color: #685B50;
  font-size: 24rpx;
  line-height: 1.65;
}

.route-detail-action-button {
  min-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.route-detail-favorite-button {
  background: rgba(209, 170, 130, 0.18);
}

.route-detail-favorite-button--active {
  background: #4F4A46;
  color: #FBF7F0;
}
