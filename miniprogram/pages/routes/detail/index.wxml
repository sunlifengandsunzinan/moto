<view class="page-shell route-detail-page">
  <view class="topbar">
    <view class="topbar-copy">
      <text class="eyebrow">{{page.eyebrow}}</text>
      <text class="page-title">{{page.title}}</text>
    </view>
    <view class="topbar-action" bindtap="handleBack">
      <text>返回路线</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card loading">
    <text class="subtle">正在加载路线详情...</text>
  </view>

  <block wx:else>
    <view class="card route-detail-shot-card">
      <view class="section-header">
        <view>
          <text class="eyebrow">途径点路线图</text>
          <text class="route-detail-section-title">高德路线截图</text>
        </view>
      </view>
      <block wx:if="{{route.amap_export.screenshot_url}}">
        <image
          class="route-detail-shot-image"
          src="{{route.amap_export.screenshot_url}}"
          mode="widthFix"
        />
      </block>
      <block wx:else>
        <view class="route-detail-shot-placeholder">
          <text class="subtle">当前没有可展示的路线截图。</text>
        </view>
      </block>
    </view>

    <view wx:if="{{route.gpx.is_available}}" class="card route-detail-gpx-card">
      <view class="section-header">
        <view>
          <text class="eyebrow">GPX 同步</text>
          <text class="route-detail-section-title">提取轨迹</text>
        </view>
        <view class="route-detail-gpx-badges">
          <text class="inline-badge">GPX</text>
          <text wx:if="{{route.gpx.source_badge}}" class="route-detail-source-badge">{{route.gpx.source_badge}}</text>
        </view>
      </view>

      <view class="route-detail-gpx-copy">
        <text class="route-detail-gpx-title">{{route.gpx.source_title}}</text>
        <view wx:if="{{route.gpx.meta_text}}"><text class="subtle">{{route.gpx.meta_text}}</text></view>
      </view>

      <view wx:if="{{route.gpx.facts.length}}" class="route-detail-gpx-strip-list">
        <view wx:for="{{route.gpx.facts}}" wx:key="label" class="route-detail-gpx-strip-item">
          <text class="route-detail-gpx-strip-item__label">{{item.label}}</text>
          <text class="route-detail-gpx-strip-item__value">{{item.value}}</text>
        </view>
      </view>

      <view class="route-detail-gpx-actions">
        <button wx:if="{{route.amap_export.is_available}}" class="button-secondary route-detail-action-button" data-href="{{route.amap_export.href}}" catchtap="handleDirectNavigate">直接导航</button>
        <button class="button-secondary route-detail-action-button" data-href="{{route.gpx.download_href}}" data-filename="{{route.gpx.filename}}" catchtap="handleDownloadGpx">{{route.gpx.download_label}}</button>
      </view>
    </view>

    <view class="card route-detail-schedule-card">
      <view class="section-header">
        <view>
          <text class="eyebrow">示例日程</text>
          <text class="route-detail-section-title">{{route.days}} 天路书拆分</text>
        </view>
        <text class="inline-badge">沿途节奏</text>
      </view>

      <view class="list-column route-stage-list-detail">
        <view wx:for="{{detailSections.daily_plan}}" wx:key="day" class="route-stage-item-detail">
          <text class="route-stage-day-detail">Day {{item.day}}</text>
          <view class="route-stage-track-detail">
            <view class="route-stage-marker-detail"></view>
            <view class="route-day-card-detail">
              <text class="route-stage-title-detail">{{item.title}}</text>
              <view><text class="subtle">{{item.ride_time}} · {{item.distance}}</text></view>
              <view class="tag-row route-day-tag-row">
                <text wx:for="{{item.highlights}}" wx:key="*this" class="tag">{{item}}</text>
              </view>
              <view><text class="card-desc">{{item.note}}</text></view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>
</view>