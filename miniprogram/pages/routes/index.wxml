<view class="page-shell route-page-shell">
  <view class="route-filter-shell">
    <scroll-view class="route-filter-strip" scroll-x enable-flex show-scrollbar="false">
      <view class="route-filter-tabs">
        <text
          wx:for="{{durationFilters}}"
          wx:key="key"
          class="chip route-filter-tab {{item.is_active ? 'chip-active route-filter-tab--active' : ''}}"
          data-filter-key="{{item.key}}"
          bindtap="handleDurationFilter"
        >{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="card loading">
    <text class="subtle">正在加载路线数据...</text>
  </view>

  <view wx:elif="{{error}}" class="card error">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:else class="list-column">
    <view
      wx:for="{{routes}}"
      wx:for-item="route"
      wx:key="slug"
      class="card list-card route-card-v2"
      data-slug="{{route.slug}}"
      bindtap="handleOpenRoute"
    >
      <view class="route-roadbar">
        <text class="route-roadbar__label">ROADBOOK</text>
        <view class="route-roadbar__lane"></view>
      </view>
      <view class="list-card-header">
        <view>
          <text class="list-card-title">{{route.title}}</text>
        </view>
        <view class="route-meta-pill">
          <text>{{route.distance_km}} km</text>
        </view>
      </view>
      <view class="route-meta-line">
        <text class="route-meta-line__item">{{route.days}} 天</text>
        <text class="route-meta-line__divider">·</text>
        <text class="route-meta-line__item">{{route.waypoint_count}} 个途径点</text>
      </view>
      <view wx:if="{{route.gpx.is_available}}" class="route-gpx-brief">
        <text class="route-gpx-brief__badge">GPX</text>
        <view class="route-gpx-brief__copy">
          <text class="route-gpx-brief__title">{{route.gpx.source_title}}</text>
          <view wx:if="{{route.gpx.meta_text}}"><text class="subtle">{{route.gpx.meta_text}}</text></view>
        </view>
      </view>
      <view class="route-stage-block">
        <view class="route-stage-head">
          <text class="route-stage-heading">{{route.days}} 天路线拆分</text>
        </view>
        <view class="list-column route-stage-list">
          <view wx:for="{{route.days_plan}}" wx:key="day" class="route-stage-item">
            <text class="route-stage-day">Day {{item.day}}</text>
            <view class="route-stage-track">
              <view class="route-stage-marker"></view>
              <view>
                <text class="route-stage-title">{{item.title}}</text>
                <view><text class="subtle">约 {{item.distance}} km</text></view>
              </view>
            </view>
          </view>
        </view>
      </view>
      <view class="route-card-footer">
        <button class="button-secondary route-direct-button route-favorite-button {{route.is_favorite ? 'route-favorite-button--active' : ''}}" data-slug="{{route.slug}}" catchtap="handleToggleFavorite">{{route.is_favorite ? '已收藏' : '收藏'}}</button>
        <button wx:if="{{route.amap_export.is_available}}" class="button-secondary route-direct-button" data-href="{{route.amap_export.href}}" catchtap="handleDirectNavigate">直接导航</button>
        <button wx:if="{{route.gpx.is_available}}" class="button-secondary route-direct-button route-download-button" data-href="{{route.gpx.download_href}}" data-filename="{{route.gpx.filename}}" catchtap="handleDownloadGpx">GPX 文件下载</button>
      </view>
    </view>

    <view wx:if="{{!routes.length}}" class="card empty">
      <text class="card-title">{{emptyState.title}}</text>
      <view><text class="card-desc">{{emptyState.description}}</text></view>
    </view>
  </view>
</view>