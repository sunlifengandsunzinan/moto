<view class="page-shell route-reference-page">
  <view class="route-toolbar">
    <view class="route-sort" bindtap="handleToggleSort">
      <text class="route-sort__label">排序</text>
      <text class="route-sort__value">{{sortLabel}}</text>
      <text class="route-sort__arrow">⌄</text>
    </view>
    <view class="route-search-box">
      <text class="route-search-box__icon">⌕</text>
      <input
        class="route-search-box__input"
        value="{{keyword}}"
        placeholder="搜索路线"
        confirm-type="search"
        bindinput="handleSearchInput"
      />
      <text wx:if="{{keyword}}" class="route-search-box__clear" bindtap="handleSearchClear">✕</text>
    </view>
  </view>

  <view class="route-filter-shell" wx:if="{{false}}">
    <scroll-view class="route-filter-strip" scroll-x enable-flex show-scrollbar="false">
      <view class="route-filter-tabs">
        <text
          wx:for="{{durationFilters}}"
          wx:key="key"
          class="chip route-filter-tab {{item.is_active ? 'chip-active route-filter-tab--active' : ''}}"
          data-filter-value="{{item.value}}"
          bindtap="handleDurationFilter"
        >{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="card loading">
    <text class="subtle">正在加载路线数据...</text>
  </view>

  <view wx:elif="{{error}}" class="card error">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:else class="list-column route-card-list">
    <view
      wx:for="{{routes}}"
      wx:for-item="route"
      wx:key="slug"
      class="route-image-card"
      data-slug="{{route.slug}}"
      bindtap="handleOpenRoute"
    >
      <view class="route-image-shell">
        <image
          wx:if="{{route.cover_image_url}}"
          class="route-image"
          src="{{route.cover_image_url}}"
          mode="aspectFill"
        />
        <view wx:else class="route-image route-image--fallback">
          <text class="route-image--fallback-text">{{route.title}}</text>
        </view>

        <view class="route-heat-corner">
          <text class="route-heat-corner__icon">🔥</text>
          <text class="route-heat-corner__value">{{route.engagement.want_go_count}}</text>
        </view>

        <view
          class="route-want-go-mini {{route.want_go.plan_bucket ? 'route-want-go-mini--active' : ''}}"
          data-slug="{{route.slug}}"
          catchtap="handleSetWantGo"
        >
          <text class="route-want-go-mini__text">{{route.want_go.plan_bucket ? '✓' : '+'}}</text>
        </view>

        <view class="route-title-overlay">
          <text class="route-title-overlay__text">{{route.title}}</text>
        </view>
      </view>

      <view class="route-kpi-row">
        <view class="route-kpi-box"><text>总里程数：{{route.distance_km}}km</text></view>
        <view class="route-kpi-box"><text>预估时长：{{route.estimated_duration_label}}</text></view>
        <view class="route-kpi-box"><text>跑完奖励积分：{{route.reward_points_label}}</text></view>
      </view>

      <view class="route-action-row" wx:if="{{false}}">
        <button wx:if="{{false}}" class="button-secondary route-action-btn route-favorite-button {{route.is_favorite ? 'route-favorite-button--active' : ''}}" data-slug="{{route.slug}}" catchtap="handleToggleFavorite">{{route.is_favorite ? '已收藏' : '收藏'}}</button>
        <button wx:if="{{false}}" class="button-secondary route-action-btn" data-slug="{{route.slug}}" catchtap="handleDirectNavigate">直接导航</button>
      </view>
    </view>

    <view wx:if="{{!routes.length}}" class="card empty">
      <text class="card-title">{{emptyState.title}}</text>
      <view><text class="card-desc">{{emptyState.description}}</text></view>
    </view>
  </view>
</view>
