<view class="page-shell">
  <view class="route-filter-shell">
    <scroll-view class="route-filter-strip" scroll-x enable-flex show-scrollbar="false">
      <view class="route-filter-tabs">
        <text
          wx:for="{{durationFilters}}"
          wx:key="key"
          class="route-filter-tab {{item.is_active ? 'route-filter-tab--active' : ''}}"
          data-filter-key="{{item.key}}"
          bindtap="handleDurationFilter"
        >{{item.label}}</text>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="card loading">
    <text class="subtle">正在加载路线数据...</text>
  </view>

  <view wx:elif="{{error}}" class="card error">
    <text class="error-text">{{error}}</text>
  </view>

  <view wx:else class="list-column">
    <view
      wx:for="{{routes}}"
      wx:for-item="route"
      wx:key="slug"
      class="list-card route-card-v2"
      data-slug="{{route.slug}}"
      bindtap="handleOpenRoute"
    >
      <view class="list-card-header">
        <view>
          <text class="list-card-title">{{route.title}}</text>
          <view>
            <text class="card-desc route-summary">{{route.summary}}</text>
          </view>
        </view>
      </view>
      <view class="route-meta-line">
        <text class="route-meta-line__item">{{route.distance_km}} km</text>
        <text class="route-meta-line__divider">·</text>
        <text class="route-meta-line__item">{{route.days}} 天</text>
        <text class="route-meta-line__divider">·</text>
        <text class="route-meta-line__item">{{route.waypoint_count}} 个途径点</text>
      </view>
      <view class="route-card-footer">
        <view wx:if="{{route.amap_export.status_text}}" class="route-navigation-hint route-navigation-hint--{{route.amap_export.status_variant}}">
          <text class="route-navigation-hint__badge">{{route.amap_export.status_badge}}</text>
          <text class="route-navigation-hint__text">{{route.amap_export.status_text}}</text>
        </view>
        <button wx:if="{{route.amap_export.is_available}}" class="button-primary route-card-nav" data-href="{{route.amap_export.href}}" catchtap="handleDirectNavigate">导航</button>
      </view>
    </view>

    <view wx:if="{{!routes.length}}" class="card empty">
      <text class="empty-text">当前还没有匹配路线。</text>
    </view>
  </view>
</view>