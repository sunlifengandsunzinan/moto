.route-reference-page {
  padding-top: 16rpx;
}

.route-toolbar {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 14rpx;
}

.route-sort {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 70rpx;
  padding: 0 18rpx;
  border: 2rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.route-sort__label,
.route-sort__value,
.route-sort__arrow {
  font-size: 24rpx;
  color: #111;
}

.route-search-box {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  min-height: 70rpx;
  padding: 0 16rpx;
  border: 2rpx solid #111;
  border-radius: 8rpx;
  background: #fff;
  box-sizing: border-box;
}

.route-search-box__icon,
.route-search-box__clear {
  color: #444;
  font-size: 26rpx;
}

.route-search-box__input {
  width: 100%;
  min-width: 0;
  font-size: 24rpx;
  color: #1f1f1f;
  padding: 0 12rpx;
}

.route-filter-shell {
  margin-bottom: 16rpx;
}

.route-filter-strip {
  white-space: nowrap;
}

.route-filter-tabs {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 16rpx;
}

.route-filter-tab {
  flex-shrink: 0;
}

.route-card-list {
  gap: 36rpx;
}

.route-image-card {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.route-image-shell {
  position: relative;
  overflow: hidden;
  border-radius: 0;
  border: 2rpx solid #161616;
  background: #f2f2f2;
}

.route-image {
  width: 100%;
  height: 360rpx;
  display: block;
}

.route-image--fallback {
  display: flex;
  align-items: center;
  justify-content: center;
}

.route-image--fallback-text {
  padding: 0 24rpx;
  font-size: 30rpx;
  line-height: 1.3;
  color: #121212;
  font-weight: 700;
}

.route-heat-corner {
  position: absolute;
  right: 58rpx;
  top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  min-height: 44rpx;
  padding: 0 14rpx;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.72);
  box-sizing: border-box;
}

.route-heat-corner__icon,
.route-heat-corner__value {
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.route-want-go-mini {
  position: absolute;
  right: 14rpx;
  top: 17rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.98);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.42);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.38), 0 0 10rpx rgba(255, 255, 255, 0.28);
}

.route-want-go-mini__text {
  color: #ffffff;
  font-size: 21rpx;
  line-height: 1;
  font-weight: 700;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.45);
}

.route-want-go-mini--active {
  border-color: #ffbf5f;
  background: rgba(255, 191, 95, 0.32);
  box-shadow: 0 0 0 1rpx rgba(0, 0, 0, 0.24), 0 0 12rpx rgba(255, 191, 95, 0.45);
}

.route-want-go-mini--active .route-want-go-mini__text {
  color: #ffd99b;
}

.route-title-overlay {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 14rpx 18rpx;
  background: rgba(0, 0, 0, 0.64);
}

.route-title-overlay__text {
  color: #fff;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 700;
}

.route-kpi-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.route-kpi-box {
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 12rpx;
  border: 2rpx solid #1a1a1a;
  border-radius: 0;
  background: #fff;
  box-sizing: border-box;
}

.route-kpi-box text {
  color: #111;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 500;
}

.route-action-row {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 12rpx;
}

.route-action-btn {
  min-height: 64rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.route-favorite-button {
  background: rgba(209, 170, 130, 0.18);
}

.route-favorite-button--active {
  background: #4f4a46;
  color: #fbf7f0;
}

@media (max-width: 600rpx) {
  .route-kpi-row {
    grid-template-columns: 1fr;
  }
}
