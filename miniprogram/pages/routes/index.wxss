.route-topbar-action,
.route-hero-action,
.route-inline-button {
  min-height: 84rpx;
}

.route-hero-card {
  margin-bottom: 20rpx;
}

.route-filter-panel {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #F2E8DC;
}

.route-panel-title {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #47413C;
}

.route-filter-strip {
  margin-top: 18rpx;
  white-space: nowrap;
}

.route-filter-tabs {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding-right: 12rpx;
}

.route-filter-tab {
  flex-shrink: 0;
}

.route-card-v2 {
  gap: 20rpx;
}

.route-roadbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.route-roadbar__label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #8A7A6B;
}

.route-roadbar__lane {
  flex: 1;
  height: 2rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(209, 170, 130, 0.9) 0%, rgba(91, 83, 77, 0.12) 100%);
}

.route-summary {
  display: block;
  margin-top: 8rpx;
}

.route-meta-pill {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 120rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F2E8DC;
  color: #4A433E;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.route-fact-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.route-fact-chip {
  flex: 1 1 calc(50% - 8rpx);
  min-width: 0;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: #F2E8DC;
  box-sizing: border-box;
}

.route-fact-chip__label {
  display: block;
  font-size: 22rpx;
  color: #8A7A6B;
}

.route-fact-chip__value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  color: #4A433E;
  font-weight: 700;
}

.route-tag-row {
  margin-top: 0;
}

.route-stage-block,
.route-map-card {
  padding: 22rpx;
  border-radius: 24rpx;
  background: rgba(255, 251, 245, 0.76);
  border: 2rpx solid rgba(91, 83, 77, 0.08);
  box-sizing: border-box;
}

.route-stage-list {
  gap: 18rpx;
}

.route-stage-item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 16rpx;
  align-items: start;
}

.route-stage-track {
  display: grid;
  grid-template-columns: 18rpx 1fr;
  gap: 16rpx;
}

.route-stage-marker {
  width: 18rpx;
  min-height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #D1AA82 0 16%, #5B534D 16% 34%, #F7EFE4 34% 52%, #5B534D 52% 70%, #D1AA82 70% 100%);
}

.route-stage-day {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #4F4A46;
  color: #FBF7F0;
  font-size: 24rpx;
  box-sizing: border-box;
}

.route-stage-title {
  color: #4A433E;
  line-height: 1.5;
  font-size: 28rpx;
  font-weight: 700;
}

.route-map-card {
  display: grid;
  grid-template-columns: 8rpx 1fr auto;
  gap: 18rpx;
  align-items: start;
}

.route-map-card__lane {
  width: 8rpx;
  min-height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, rgba(209, 170, 130, 0.92) 0%, rgba(91, 83, 77, 0.16) 100%);
}

.route-map-card__body {
  min-width: 0;
}

.route-waypoint-text {
  display: block;
  margin-top: 8rpx;
  color: #4A433E;
  line-height: 1.6;
}

.route-map-actions {
  justify-content: flex-end;
}

.route-card-actions {
  gap: 12rpx;
}

.route-navigation-hint {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  gap: 6rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(79, 74, 70, 0.1);
  background: rgba(79, 74, 70, 0.08);
  color: #5B534D;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.route-navigation-hint__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(79, 74, 70, 0.12);
  font-size: 16rpx;
  font-weight: 700;
}

.route-navigation-hint__text {
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-navigation-hint--complete {
  background: rgba(74, 123, 82, 0.12);
  border-color: rgba(74, 123, 82, 0.2);
  color: #33553A;
}

.route-navigation-hint--complete .route-navigation-hint__badge {
  background: rgba(74, 123, 82, 0.18);
  color: #33553A;
}

.route-navigation-hint--partial {
  background: rgba(184, 126, 48, 0.12);
  border-color: rgba(184, 126, 48, 0.2);
  color: #7B531C;
}

.route-navigation-hint--partial .route-navigation-hint__badge {
  background: rgba(184, 126, 48, 0.18);
  color: #7B531C;
}

.route-navigation-hint--names {
  background: rgba(79, 74, 70, 0.08);
  border-color: rgba(79, 74, 70, 0.12);
  color: #5B534D;
}

.actions-row--compact {
  margin-top: 20rpx;
}