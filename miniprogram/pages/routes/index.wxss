.route-filter-strip {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 20rpx;
}

.route-card-v2 {
  position: relative;
  overflow: hidden;
  gap: 18rpx;
}

.route-roadbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.route-roadbar__label {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #8B7C6D;
}

.route-roadbar__lane {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #5B534D 0 20%, transparent 20% 30%, #D1AA82 30% 48%, transparent 48% 58%, #5B534D 58% 100%);
  opacity: 0.82;
}

.route-meta-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #EFE4D7;
  color: #5B534D;
  font-size: 24rpx;
  font-weight: 600;
}

.route-fact-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.route-fact-chip {
  min-width: 0;
  flex: 1 1 calc(50% - 16rpx);
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: rgba(239, 228, 215, 0.76);
  border: 2rpx solid rgba(91, 83, 77, 0.08);
}

.route-fact-chip__label {
  display: block;
  font-size: 22rpx;
  color: #8B7C6D;
}

.route-fact-chip__value {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #4A433E;
}

.route-stage-block,
.route-map-card {
  padding: 20rpx;
  border-radius: 24rpx;
  background: #FBF7F0;
  border: 2rpx solid rgba(91, 83, 77, 0.1);
}

.route-stage-item {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 16rpx;
  align-items: start;
}

.route-stage-list {
  position: relative;
}

.route-stage-track {
  display: grid;
  grid-template-columns: 18rpx 1fr;
  gap: 16rpx;
}

.route-stage-marker {
  width: 18rpx;
  min-height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(180deg, #D1AA82 0 16%, #5B534D 16% 34%, #F7EFE4 34% 52%, #5B534D 52% 70%, #D1AA82 70% 100%);
}

.route-stage-day {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 100rpx;
  min-height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #4F4A46;
  color: #FBF7F0;
  font-size: 24rpx;
}

.route-stage-title {
  color: #4A433E;
  line-height: 1.5;
  font-size: 28rpx;
}

.route-map-card {
  position: relative;
  overflow: hidden;
}

.route-map-card__lane {
  position: absolute;
  top: 18rpx;
  right: -34rpx;
  width: 180rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, rgba(91, 83, 77, 0.95) 0 26%, rgba(251, 247, 240, 0.6) 26% 38%, rgba(209, 170, 130, 0.95) 38% 70%, rgba(251, 247, 240, 0.6) 70% 82%, rgba(91, 83, 77, 0.95) 82% 100%);
  transform: rotate(-18deg);
  opacity: 0.32;
}

.route-navigation-hint {
  display: inline-flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
  padding: 10rpx 16rpx;
  border-radius: 22rpx;
  border: 2rpx solid rgba(79, 74, 70, 0.12);
  background: rgba(79, 74, 70, 0.08);
  color: #5B534D;
  font-size: 22rpx;
  line-height: 1.5;
}

.route-navigation-hint__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(79, 74, 70, 0.12);
  font-size: 20rpx;
  font-weight: 700;
}

.route-navigation-hint__text {
  flex: 1;
}

.route-navigation-hint--complete {
  background: rgba(74, 123, 82, 0.12);
  border-color: rgba(74, 123, 82, 0.2);
  color: #33553A;
}

.route-navigation-hint--complete .route-navigation-hint__badge {
  background: rgba(74, 123, 82, 0.18);
  color: #33553A;
}

.route-navigation-hint--partial {
  background: rgba(184, 126, 48, 0.12);
  border-color: rgba(184, 126, 48, 0.2);
  color: #7B531C;
}

.route-navigation-hint--partial .route-navigation-hint__badge {
  background: rgba(184, 126, 48, 0.18);
  color: #7B531C;
}

.route-navigation-hint--names {
  background: rgba(79, 74, 70, 0.08);
  border-color: rgba(79, 74, 70, 0.12);
  color: #5B534D;
}

.actions-row--compact {
  margin-top: 20rpx;
}