.route-filter-shell {
  margin-bottom: 12rpx;
  padding: 4rpx 0 0;
}

.route-filter-strip {
  white-space: nowrap;
}

.route-filter-tabs {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding-right: 16rpx;
}

.route-filter-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: rgba(239, 227, 213, 0.78);
  color: #675D56;
  font-size: 24rpx;
  box-sizing: border-box;
}

.route-filter-tab--active {
  background: #4F4A46;
  color: #FBF7F0;
}

.route-card-v2 {
  position: relative;
  gap: 10rpx;
  margin-bottom: 0;
  padding: 20rpx 8rpx 20rpx 0;
  border-bottom: 2rpx solid rgba(91, 83, 77, 0.1);
}

.route-summary {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.route-card-v2:last-child {
  border-bottom: 0;
}

.route-meta-line {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.route-meta-line__item,
.route-meta-line__divider {
  font-size: 22rpx;
  color: #8B7C6D;
}

.route-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.route-navigation-hint {
  display: inline-flex;
  align-items: center;
  max-width: 100%;
  gap: 6rpx;
  padding: 4rpx 10rpx;
  border-radius: 999rpx;
  border: 2rpx solid rgba(79, 74, 70, 0.1);
  background: rgba(79, 74, 70, 0.08);
  color: #5B534D;
  font-size: 18rpx;
  line-height: 1.2;
  white-space: nowrap;
}

.route-navigation-hint__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  background: rgba(79, 74, 70, 0.12);
  font-size: 16rpx;
  font-weight: 700;
}

.route-navigation-hint__text {
  overflow: hidden;
  text-overflow: ellipsis;
}

.route-navigation-hint--complete {
  background: rgba(74, 123, 82, 0.12);
  border-color: rgba(74, 123, 82, 0.2);
  color: #33553A;
}

.route-navigation-hint--complete .route-navigation-hint__badge {
  background: rgba(74, 123, 82, 0.18);
  color: #33553A;
}

.route-navigation-hint--partial {
  background: rgba(184, 126, 48, 0.12);
  border-color: rgba(184, 126, 48, 0.2);
  color: #7B531C;
}

.route-navigation-hint--partial .route-navigation-hint__badge {
  background: rgba(184, 126, 48, 0.18);
  color: #7B531C;
}

.route-navigation-hint--names {
  background: rgba(79, 74, 70, 0.08);
  border-color: rgba(79, 74, 70, 0.12);
  color: #5B534D;
}

.route-card-nav {
  min-width: 116rpx;
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.actions-row--compact {
  margin-top: 20rpx;
}