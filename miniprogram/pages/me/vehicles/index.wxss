.me-vehicles-page {
  padding-top: 12rpx;
}

.vehicles-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.vehicles-toolbar__title {
  font-size: 30rpx;
  color: #1d1d1d;
  font-weight: 700;
}

.vehicles-toolbar__button {
  margin: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  border: 2rpx solid #dcc8a5;
  background: #fff5e7;
  color: #6d4514;
  font-size: 22rpx;
}

.vehicles-toolbar__button::after {
  border: 0;
}

.vehicle-list {
  display: grid;
  gap: 14rpx;
}

.vehicle-card {
  border-radius: 16rpx;
  border: 2rpx solid #e8ded1;
  background: #fff;
  padding: 14rpx;
}

.vehicle-card__head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.vehicle-card__title-block {
  flex: 1;
  min-width: 0;
  display: grid;
  gap: 4rpx;
}

.vehicle-card__title {
  font-size: 28rpx;
  color: #202020;
  font-weight: 700;
}

.vehicle-card__meta {
  font-size: 20rpx;
  color: #585858;
}

.vehicle-card__actions {
  display: grid;
  gap: 8rpx;
}

.maintenance-header {
  margin-top: 12rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid #efe7db;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.maintenance-header__right {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.maintenance-header__actions {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.maintenance-header__title {
  font-size: 22rpx;
  color: #2a2a2a;
  font-weight: 600;
}

.maintenance-header__count {
  font-size: 20rpx;
  color: #8a6b41;
}

.maintenance-fold-tag {
  font-size: 22rpx;
  color: #8a6b41;
}

.maintenance-card {
  margin-top: 10rpx;
  border-radius: 12rpx;
  background: #f9f4ec;
  padding: 10rpx;
}

.maintenance-list {
  margin-top: 10rpx;
  display: grid;
  gap: 8rpx;
}

.maintenance-item {
  border-radius: 12rpx;
  background: #f9f4ec;
  padding: 14rpx;
  overflow: hidden;
}

.maintenance-item__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.maintenance-item__right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
  margin-left: auto;
  flex: none;
}

.maintenance-item__row--sub {
  margin-top: 4rpx;
  justify-content: flex-start;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 6rpx 18rpx;
}

.maintenance-item__title {
  font-size: 26rpx;
  color: #2a2a2a;
  font-weight: 700;
  flex: 1;
  min-width: 0;
  white-space: normal;
  overflow-wrap: anywhere;
}

.maintenance-item__meta {
  font-size: 22rpx;
  color: #666;
}

.maintenance-item__row--sub .maintenance-item__meta {
  flex: 1 1 320rpx;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.maintenance-item__row--date .maintenance-item__meta {
  flex: 1 1 100%;
  white-space: normal;
  overflow: visible;
  text-overflow: clip;
}

.maintenance-item__note {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7a6546;
  display: block;
}

.maintenance-item__date {
  white-space: nowrap;
  color: #5f5f5f;
}

.maintenance-item__actions {
  margin-top: 8rpx;
  display: flex;
  justify-content: flex-end;
  gap: 8rpx;
}

.mini-btn {
  margin: 0;
  min-height: 44rpx;
  line-height: 44rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d8d8d8;
  background: #fff;
  color: #3c3c3c;
  font-size: 18rpx;
  padding: 0 14rpx;
}

.mini-btn::after {
  border: 0;
}

.mini-btn--danger {
  border-color: #f0c7c1;
  background: #fff2f1;
  color: #9f3d35;
}

.maintenance-text-action {
  margin: 0;
  min-height: 52rpx;
  line-height: 52rpx;
  border-radius: 0;
  border: 0;
  background: transparent;
  color: #8a6b41;
  font-size: 22rpx;
  padding: 0 8rpx;
  text-align: center;
}

.maintenance-text-action::after {
  border: 0;
}

.maintenance-text-action--danger {
  color: #8a6b41;
}

.maintenance-text-action--delete {
  padding: 0 12rpx;
}

.card--subtle {
  margin-top: 8rpx;
  background: #faf7f2;
}

.editor-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
  padding: 0 30rpx;
  box-sizing: border-box;
}

.editor-dialog {
  width: 100%;
  max-height: 82vh;
  overflow-y: auto;
  border-radius: 18rpx;
  background: #fff;
  padding: 20rpx;
  box-sizing: border-box;
}

.editor-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 12rpx;
}

.editor-input {
  width: 100%;
  height: 70rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e3d9cb;
  padding: 0 16rpx;
  box-sizing: border-box;
  margin-bottom: 10rpx;
  font-size: 24rpx;
}

.editor-textarea {
  width: 100%;
  min-height: 120rpx;
  border-radius: 12rpx;
  border: 1rpx solid #e3d9cb;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
}

.editor-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
}

.editor-btn {
  margin: 0;
  min-width: 140rpx;
  height: 60rpx;
  line-height: 60rpx;
  border-radius: 999rpx;
  border: 1rpx solid #171717;
  background: #171717;
  color: #fff;
  font-size: 22rpx;
}

.editor-btn::after {
  border: 0;
}

.editor-btn--ghost {
  border-color: #ddd;
  background: #fff;
  color: #333;
}
