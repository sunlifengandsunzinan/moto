.terms-page {
  padding: 28rpx 28rpx 44rpx;
  background: #ffffff;
  color: #1f1f1f;
  min-height: 100vh;
  box-sizing: border-box;
}

.terms-title {
  text-align: center;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 700;
  margin-top: 12rpx;
}

.terms-date {
  text-align: center;
  margin-top: 20rpx;
  margin-bottom: 22rpx;
  color: #8f8f8f;
  font-size: 24rpx;
}

.terms-section-title {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 700;
  margin-top: 28rpx;
  margin-bottom: 14rpx;
}

.terms-paragraph {
  font-size: 30rpx;
  line-height: 1.9;
  color: #2a2a2a;
}