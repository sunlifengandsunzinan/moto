.me-profile-card {
  margin-bottom: 20rpx;
}

.me-profile-card__header {
  margin-bottom: 24rpx;
}

.me-profile-card__body {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.me-profile-card__avatar-shell {
  flex: none;
  width: 116rpx;
  height: 116rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(180deg, rgba(255, 252, 247, 0.98) 0%, rgba(242, 232, 220, 0.98) 100%);
  border: 2rpx solid rgba(91, 83, 77, 0.08);
  box-shadow: 0 18rpx 40rpx rgba(93, 83, 71, 0.1);
}

.me-profile-card__avatar-shell--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.me-profile-card__avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.me-profile-card__avatar-placeholder {
  font-size: 40rpx;
  font-weight: 700;
  color: #8F7D6D;
  letter-spacing: 0.08em;
}

.me-profile-card__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.me-profile-card__name {
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #47413C;
}

.me-profile-card__meta {
  font-size: 24rpx;
  color: #8A7A6B;
}

.me-profile-card__actions {
  margin-top: 24rpx;
}

.me-profile-card__button {
  width: 100%;
}

.me-favorite-entry {
  margin-bottom: 20rpx;
}

.me-favorite-entry__header {
  margin-bottom: 18rpx;
}

.me-favorite-entry__body {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.me-favorite-entry__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.me-favorite-entry__meta {
  font-size: 24rpx;
  color: #8A7A6B;
}

.me-favorite-entry__chevron {
  flex: none;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #F2E8DC;
  color: #5E554E;
  font-size: 24rpx;
}
