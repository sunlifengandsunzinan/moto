.me-reference-page {
  padding-top: 18rpx;
}

.me-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 8rpx 18rpx;
}

.me-hero__avatar-shell {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f0f0f0;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.me-hero__avatar-shell--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8f8f8 0%, #e9e9e9 100%);
}

.me-hero__avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.me-hero__avatar-placeholder {
  font-size: 44rpx;
  color: #555;
  font-weight: 600;
}

.me-hero__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.me-hero__name {
  font-size: 28rpx;
  color: #111;
  font-weight: 500;
}

.me-hero__meta {
  font-size: 22rpx;
  color: #8a8a8a;
}

.me-stats-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 16rpx;
  padding: 26rpx 12rpx;
  border-radius: 28rpx;
  background: #2d2d2d;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.16);
}

.me-stats-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 136rpx;
}

.me-stats-card__value {
  font-size: 44rpx;
  line-height: 1;
  color: #fff;
  font-weight: 500;
}

.me-stats-card__label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.me-club-banner {
  position: relative;
  overflow: hidden;
  margin-top: 26rpx;
  min-height: 220rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.me-club-banner__pattern {
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.08) 0 2rpx, transparent 2rpx 14rpx),
    repeating-linear-gradient(155deg, rgba(0, 0, 0, 0.035) 0 2rpx, transparent 2rpx 18rpx);
  opacity: 0.6;
}

.me-club-banner__copy {
  position: relative;
  z-index: 1;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.me-club-banner__line {
  font-size: 24rpx;
  color: #151515;
  font-weight: 500;
}

.me-grid-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22rpx 8rpx;
  margin-top: 28rpx;
  padding: 26rpx 18rpx 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.12);
}

.me-grid-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.me-grid-card__icon {
  font-size: 40rpx;
  line-height: 1;
  color: #222;
}

.me-grid-card__label {
  text-align: center;
  font-size: 18rpx;
  line-height: 1.3;
  color: #1f1f1f;
}

.me-legal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 42rpx 0 8rpx;
  color: #999;
  font-size: 18rpx;
}

.me-legal-row__divider {
  color: #c6c6c6;
}

.me-legal-row__link {
  color: #7f7f7f;
}

.me-legal-row__link:active {
  opacity: 0.7;
}
