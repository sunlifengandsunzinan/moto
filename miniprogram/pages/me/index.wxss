.me-reference-page {
  padding-top: 18rpx;
}

.me-hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 8rpx 8rpx 18rpx;
}

.me-hero__avatar-shell {
  width: 112rpx;
  height: 112rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #f0f0f0;
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.me-hero__avatar-shell--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8f8f8 0%, #e9e9e9 100%);
}

.me-hero__avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.me-hero__avatar-placeholder {
  font-size: 44rpx;
  color: #555;
  font-weight: 600;
}

.me-hero__copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.me-hero__name {
  font-size: 28rpx;
  color: #111;
  font-weight: 500;
}

.me-hero__meta {
  font-size: 22rpx;
  color: #8a8a8a;
}

.me-hero__logout {
  margin-top: 8rpx;
  margin-left: 0;
  width: 170rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 999rpx;
  border: 1rpx solid #d7cfbf;
  background: #ffffff;
  color: #333;
  font-size: 22rpx;
  padding: 0;
}

.me-hero__logout::after {
  border: 0;
}

.me-login-editor {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid #ece6dc;
  background: linear-gradient(180deg, #ffffff 0%, #fbf7f0 100%);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.08);
}

.me-login-editor__header {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.me-login-editor__title {
  font-size: 34rpx;
  color: #141414;
  font-weight: 700;
}

.me-login-editor__hint {
  font-size: 22rpx;
  color: #7f7566;
}

.me-login-editor__profile-preview {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx;
  border-radius: 20rpx;
  background: #f5f1e9;
}

.me-login-editor__avatar-shell {
  width: 92rpx;
  height: 92rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #ebe6de;
}

.me-login-editor__avatar-shell--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
}

.me-login-editor__avatar {
  width: 100%;
  height: 100%;
  display: block;
}

.me-login-editor__avatar-placeholder {
  font-size: 30rpx;
  color: #4f4a44;
  font-weight: 600;
}

.me-login-editor__nickname-input {
  flex: 1;
  height: 74rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e0d7c8;
  padding: 0 20rpx;
  font-size: 24rpx;
  line-height: 74rpx;
  font-weight: 500;
  color: #1a1a1a;
  box-sizing: border-box;
}

.me-login-editor__nickname-placeholder {
  color: #a89d8f;
  font-size: 24rpx;
}

.me-login-editor__actions {
  margin-top: 22rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.me-login-editor__actions-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.me-login-editor__button {
  width: 100%;
  height: 74rpx;
  border-radius: 18rpx;
  border: 1rpx solid #1f1f1f;
  background: #171717;
  color: #fff;
  padding: 0 16rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.me-login-editor__button--half {
  flex: 1;
  width: auto;
  min-width: 0;
}

.me-login-editor__button::after {
  border: 0;
}

.me-login-editor__button-label {
  display: block;
  font-size: 28rpx;
  line-height: 1.2;
  font-weight: 600;
  white-space: nowrap;
  transform: translateY(1rpx);
}

.me-login-editor__button-label--subtle {
  font-size: 24rpx;
  font-weight: 500;
}

.me-login-editor__button--ghost {
  background: #ffffff;
  color: #151515;
  border-color: #dbd2c5;
}

.me-login-editor__button--subtle {
  height: 62rpx;
  padding: 0;
  background: transparent;
  border-color: transparent;
  color: #7b746a;
}

.me-stats-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  margin-top: 16rpx;
  padding: 26rpx 12rpx;
  border-radius: 28rpx;
  background: #2d2d2d;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.16);
}

.me-stats-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  min-height: 136rpx;
}

.me-stats-card__value {
  font-size: 44rpx;
  line-height: 1;
  color: #fff;
  font-weight: 500;
}

.me-stats-card__label {
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.9);
}

.me-club-banner {
  position: relative;
  overflow: hidden;
  margin-top: 26rpx;
  min-height: 220rpx;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.me-club-banner__pattern {
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(135deg, rgba(0, 0, 0, 0.08) 0 2rpx, transparent 2rpx 14rpx),
    repeating-linear-gradient(155deg, rgba(0, 0, 0, 0.035) 0 2rpx, transparent 2rpx 18rpx);
  opacity: 0.6;
}

.me-club-banner__copy {
  position: relative;
  z-index: 1;
  min-height: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.me-club-banner__line {
  font-size: 24rpx;
  color: #151515;
  font-weight: 500;
}

.me-grid-card {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22rpx 8rpx;
  margin-top: 28rpx;
  padding: 26rpx 18rpx 22rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.12);
}

.me-grid-card__item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  min-width: 0;
}

.me-grid-card__icon {
  font-size: 40rpx;
  line-height: 1;
  color: #222;
}

.me-grid-card__label {
  text-align: center;
  font-size: 18rpx;
  line-height: 1.3;
  color: #1f1f1f;
}

.me-legal-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
  margin: 42rpx 0 8rpx;
  color: #999;
  font-size: 18rpx;
}

.me-legal-row__divider {
  color: #c6c6c6;
}

.me-legal-row__link {
  color: #7f7f7f;
}

.me-legal-row__link:active {
  opacity: 0.7;
}
