<view class="page-shell me-reference-page">
  <view class="me-hero" bindtap="handleHeroTap">
    <view wx:if="{{isWechatLoggedIn && wechatUserProfile && wechatUserProfile.avatarUrl}}" class="me-hero__avatar-shell">
      <image class="me-hero__avatar" src="{{wechatUserProfile.avatarUrl}}" mode="aspectFill" />
    </view>
    <view wx:else class="me-hero__avatar-shell me-hero__avatar-shell--placeholder">
      <text class="me-hero__avatar-placeholder">{{avatarText}}</text>
    </view>
    <view class="me-hero__copy">
      <text class="me-hero__name">{{displayName}}</text>
      <text wx:if="{{wechatProfileLocation}}" class="me-hero__meta">{{wechatProfileLocation}}</text>
      <button wx:if="{{isWechatLoggedIn}}" class="me-hero__logout" bindtap="handleLogout">退出登录</button>
    </view>
  </view>

  <view wx:if="{{showWechatProfileEditor && !isWechatLoggedIn}}" class="me-login-editor">
    <view class="me-login-editor__header">
      <text class="me-login-editor__title">登录行途</text>
      <text class="me-login-editor__hint">请设置头像与昵称</text>
    </view>

    <view class="me-login-editor__profile-preview">
      <view wx:if="{{draftWechatAvatarUrl}}" class="me-login-editor__avatar-shell">
        <image class="me-login-editor__avatar" src="{{draftWechatAvatarUrl}}" mode="aspectFill" />
      </view>
      <view wx:else class="me-login-editor__avatar-shell me-login-editor__avatar-shell--placeholder">
        <text class="me-login-editor__avatar-placeholder">{{avatarText}}</text>
      </view>
      <input
        class="me-login-editor__nickname-input"
        type="nickname"
        placeholder="请输入微信昵称"
        placeholder-class="me-login-editor__nickname-placeholder"
        value="{{draftWechatNickName}}"
        bindinput="handleWechatNicknameInput"
      />
    </view>

    <view class="me-login-editor__actions">
      <view class="me-login-editor__actions-row">
        <button class="me-login-editor__button me-login-editor__button--half me-login-editor__button--ghost" open-type="chooseAvatar" bindchooseavatar="handleChooseWechatAvatar">
          <text class="me-login-editor__button-label">选择微信头像</text>
        </button>
        <button class="me-login-editor__button me-login-editor__button--half" bindtap="handleSaveWechatProfileFromEditor">
          <text class="me-login-editor__button-label">保存并登录</text>
        </button>
      </view>
      <button class="me-login-editor__button me-login-editor__button--subtle" bindtap="handleCancelWechatProfileEditor">
        <text class="me-login-editor__button-label me-login-editor__button-label--subtle">取消</text>
      </button>
    </view>
  </view>

  <view class="me-stats-card">
    <view wx:for="{{metrics}}" wx:key="key" class="me-stats-card__item">
      <text class="me-stats-card__value">{{item.value}}</text>
      <text class="me-stats-card__label">{{item.label}}</text>
    </view>
  </view>

  <view class="me-club-banner">
    <view class="me-club-banner__pattern"></view>
    <view class="me-club-banner__copy">
      <text class="me-club-banner__line">您还未绑定俱乐部</text>
      <text class="me-club-banner__line">点击绑定俱乐部</text>
    </view>
  </view>

  <view class="me-grid-card">
    <view wx:for="{{quickActions}}" wx:key="key" class="me-grid-card__item" data-index="{{index}}" bindtap="handleQuickAction">
      <text class="me-grid-card__icon">{{item.icon}}</text>
      <text class="me-grid-card__label">{{item.label}}</text>
    </view>
  </view>

  <view class="me-legal-row">
    <text class="me-legal-row__link" bindtap="handleOpenUserTerms">用户服务协议</text>
    <text class="me-legal-row__divider">|</text>
    <text class="me-legal-row__link" bindtap="handleOpenPrivacyPolicy">隐私政策</text>
  </view>
</view>