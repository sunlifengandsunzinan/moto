<view class="page-shell">
  <view class="topbar">
    <view class="topbar-copy">
      <text class="eyebrow">我的</text>
      <text class="page-title">{{page.title || '我的摩旅'}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card loading">
    <text class="subtle">正在加载工作台...</text>
  </view>

  <view wx:elif="{{error}}" class="card error">
    <text class="error-text">{{error}}</text>
  </view>

  <block wx:else>
    <view class="card me-hero-card">
      <view class="me-hero-card__top">
        <view wx:if="{{profile.avatar_url}}" class="me-hero-avatar me-hero-avatar--image-wrap">
          <image class="me-hero-avatar__image" src="{{profile.avatar_url}}" mode="aspectFill" />
        </view>
        <view wx:else class="me-hero-avatar">{{profile.name ? profile.name.slice(0, 1) : '骑'}}</view>
        <view class="me-hero-copy">
          <text class="me-hero-name">{{profile.name}}</text>
          <text class="me-hero-tagline">{{profile.tagline}}</text>
        </view>
      </view>
      <view class="me-wechat-row">
        <view class="me-wechat-copy">
          <text class="me-wechat-title">{{hasWechatProfile ? '已同步微信用户信息' : '先获取微信用户信息并展示'}}</text>
          <text class="subtle">{{hasWechatProfile ? '当前昵称和头像优先使用微信资料。' : '点击后会读取你的微信头像、昵称和地区，用于“我的”页展示。'}}</text>
        </view>
        <button class="button-secondary me-wechat-button" loading="{{profileLoading}}" bindtap="handleGetWechatProfile">{{hasWechatProfile ? '重新获取' : '获取微信信息'}}</button>
      </view>
      <text class="card-desc">{{profile.summary}}</text>
      <view class="chip-row me-hero-chip-row">
        <text wx:for="{{metrics}}" wx:key="label" class="chip">{{item.label}} {{item.value}}</text>
      </view>
    </view>

    <view class="me-action-grid">
      <view class="card me-action-card me-action-card--favorite" bindtap="handleToggleFavoriteRoutes">
        <text class="me-action-card__eyebrow">快捷入口</text>
        <text class="me-action-card__title">我的收藏</text>
        <text wx:if="{{favoriteRoutes.length}}" class="subtle">已收藏 {{favoriteRoutes.length}} 条路线</text>
        <text wx:else class="subtle">还没有收藏路线</text>
      </view>
      <view
        wx:for="{{quickActions}}"
        wx:key="href"
        class="card me-action-card"
        data-href="{{item.href}}"
        bindtap="handleOpenHref"
      >
        <text class="me-action-card__eyebrow">快捷入口</text>
        <text class="me-action-card__title">{{item.label}}</text>
        <text class="subtle">{{item.kind === 'primary' ? '优先入口' : '备选入口'}}</text>
      </view>
    </view>

    <view wx:if="{{showFavoriteRoutes}}" class="card me-section-card">
      <view class="section-header">
        <view>
          <text class="eyebrow">我的路线</text>
          <text class="card-title">我的收藏</text>
        </view>
      </view>

      <view wx:if="{{favoriteRoutes.length}}" class="list-column me-favorite-list">
        <view wx:for="{{favoriteRoutes}}" wx:key="slug" class="me-favorite-card" data-slug="{{item.slug}}" bindtap="handleOpenFavorite">
          <view class="me-favorite-card__header">
            <text class="entry-title">{{item.title}}</text>
            <text class="me-favorite-card__distance">{{item.distance_km}} km</text>
          </view>
          <view><text class="subtle">{{item.days}} 天 · {{item.waypoint_count}} 个途径点</text></view>
          <view wx:if="{{item.summary}}"><text class="card-desc">{{item.summary}}</text></view>
        </view>
      </view>

      <view wx:else class="me-empty-favorite">
        <text class="subtle">路线页里点“收藏”后，这里会显示你保存的路线。</text>
      </view>
    </view>

    <view class="card me-summary-card">
      <view class="section-header">
        <view>
          <text class="eyebrow">路线概览</text>
          <text class="card-title">当前小程序焦点</text>
        </view>
      </view>
      <view class="stats-grid me-stats-grid">
        <view wx:for="{{metrics}}" wx:key="label" class="stat-item me-stat-item">
          <text class="stat-value">{{item.value}}</text>
          <text class="stat-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view wx:for="{{sections}}" wx:key="title" class="card me-section-card">
      <view class="section-header">
        <view>
          <text class="eyebrow">我的路线</text>
          <text class="card-title">{{item.title}}</text>
        </view>
      </view>

      <view wx:for="{{item.items}}" wx:key="href" class="me-entry-card" data-href="{{item.href}}" bindtap="handleOpenHref">
        <view class="me-entry-card__main">
          <text class="entry-title">{{item.label}}</text>
          <view><text class="subtle">{{item.description}}</text></view>
        </view>
        <text class="entry-arrow">进入</text>
      </view>
    </view>
  </block>
</view>