<view class="page-shell me-reference-page">
  <view class="me-hero" bindtap="handleHeroTap">
    <view wx:if="{{wechatUserProfile && wechatUserProfile.avatarUrl}}" class="me-hero__avatar-shell">
      <image class="me-hero__avatar" src="{{wechatUserProfile.avatarUrl}}" mode="aspectFill" />
    </view>
    <view wx:else class="me-hero__avatar-shell me-hero__avatar-shell--placeholder">
      <text class="me-hero__avatar-placeholder">{{avatarText}}</text>
    </view>
    <view class="me-hero__copy">
      <text class="me-hero__name">{{displayName}}</text>
      <text wx:if="{{wechatProfileLocation}}" class="me-hero__meta">{{wechatProfileLocation}}</text>
    </view>
  </view>

  <view class="me-stats-card">
    <view wx:for="{{metrics}}" wx:key="key" class="me-stats-card__item">
      <text class="me-stats-card__value">{{item.value}}</text>
      <text class="me-stats-card__label">{{item.label}}</text>
    </view>
  </view>

  <view class="me-club-banner">
    <view class="me-club-banner__pattern"></view>
    <view class="me-club-banner__copy">
      <text class="me-club-banner__line">您还未绑定俱乐部</text>
      <text class="me-club-banner__line">点击绑定俱乐部</text>
    </view>
  </view>

  <view class="me-grid-card">
    <view wx:for="{{quickActions}}" wx:key="key" class="me-grid-card__item" data-index="{{index}}" bindtap="handleQuickAction">
      <text class="me-grid-card__icon">{{item.icon}}</text>
      <text class="me-grid-card__label">{{item.label}}</text>
    </view>
  </view>

  <view class="me-legal-row">
    <text class="me-legal-row__link" bindtap="handleOpenUserTerms">用户服务协议</text>
    <text class="me-legal-row__divider">|</text>
    <text class="me-legal-row__link" bindtap="handleOpenPrivacyPolicy">隐私政策</text>
  </view>
</view>