<view class="page-shell me-collection-page">
  <view wx:if="{{loading}}" class="card">
    <text class="subtle">正在加载我的收集册...</text>
  </view>

  <view wx:elif="{{error}}" class="card">
    <text class="subtle">{{error}}</text>
  </view>

  <block wx:else>
    <view class="collection-summary-card">
      <view class="collection-summary-item">
        <text class="collection-summary-value">{{summary.route_count}}</text>
        <text class="collection-summary-label">参与路线</text>
      </view>
      <view class="collection-summary-item">
        <text class="collection-summary-value">{{summary.completed_route_count}}</text>
        <text class="collection-summary-label">集齐路线</text>
      </view>
      <view class="collection-summary-item">
        <text class="collection-summary-value">{{summary.badge_count}}</text>
        <text class="collection-summary-label">已获徽章</text>
      </view>
    </view>

    <view class="collection-section" wx:if="{{badges.length}}">
      <view class="collection-section__title">已解锁徽章</view>
      <view class="badge-list">
        <view wx:for="{{badges}}" wx:key="slug" class="badge-card">
          <view class="badge-card__title">{{item.title}}</view>
          <view class="badge-card__subtitle">{{item.subtitle}}</view>
          <view class="badge-card__meta">{{item.awarded_at}}</view>
          <button class="badge-card__share" open-type="share" data-slug="{{item.slug}}" bindtap="handleShareBadgePoster">分享海报</button>
        </view>
      </view>
    </view>

    <view class="collection-section">
      <view class="collection-section__title">路线收集进度</view>
      <view wx:if="{{routes.length}}" class="route-list">
        <view wx:for="{{routes}}" wx:key="slug" class="route-card" data-slug="{{item.slug}}" bindtap="handleOpenRoute">
          <view class="route-card__header">
            <text class="route-card__title">{{item.title}}</text>
            <text class="route-card__meta">{{item.checked_count}}/{{item.checkpoint_total}}</text>
          </view>
          <view class="route-card__track">
            <view class="route-card__fill" style="width: {{item.completion_percent}}%;"></view>
          </view>
          <view class="route-card__footer">
            <text class="route-card__desc">{{item.days}}天 · {{item.distance_km}}km · 完成{{item.completion_percent}}%</text>
            <button class="route-card__share" open-type="share" data-slug="{{item.slug}}" bindtap="handleShareRoutePoster">分享海报</button>
          </view>
        </view>
      </view>
      <view wx:else class="card">
        <text class="subtle">还没有任何打卡记录，去路线详情点“手动打卡”开始收集。</text>
      </view>
    </view>
  </block>
</view>
