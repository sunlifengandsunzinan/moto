.me-collection-page {
  padding-top: 10rpx;
}

.collection-summary-card {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0;
  padding: 20rpx 10rpx;
  border-radius: 22rpx;
  background: #2b2f34;
}

.collection-summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  min-height: 120rpx;
}

.collection-summary-value {
  font-size: 40rpx;
  color: #ffffff;
  font-weight: 600;
}

.collection-summary-label {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.85);
}

.collection-section {
  margin-top: 24rpx;
}

.club-public-card,
.club-board-card {
  border-radius: 16rpx;
  border: 2rpx solid #e6dccf;
  background: #fff;
  padding: 14rpx;
}

.club-public-card__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.club-public-card__label {
  font-size: 22rpx;
  color: #5e4b35;
}

.club-public-card__value {
  font-size: 22rpx;
  color: #2f2f2f;
  font-weight: 600;
}

.club-public-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  justify-content: flex-end;
}

.club-public-card__tag {
  border-radius: 999rpx;
  border: 2rpx solid #e8d7bf;
  padding: 4rpx 10rpx;
  font-size: 19rpx;
  color: #6f5228;
}

.club-public-posters {
  margin-top: 8rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.club-public-poster__image,
.club-public-poster__placeholder {
  width: 100%;
  height: 110rpx;
  border-radius: 10rpx;
  display: block;
  background: #f5efe4;
}

.club-public-poster__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a7a64;
  font-size: 18rpx;
}

.club-public-poster__title {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: #383838;
  line-height: 1.3;
}

.club-public-poster__footer {
  margin-top: 6rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
}

.club-public-poster__meta {
  font-size: 16rpx;
  color: #7a6a52;
}

.club-public-poster__signup {
  margin: 0;
  min-height: 42rpx;
  line-height: 42rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d5b07b;
  background: #fff7eb;
  color: #6f4b1e;
  font-size: 18rpx;
  padding: 0 12rpx;
}

.club-public-poster__signup::after {
  border: 0;
}

.club-public-poster__signup--done {
  border-color: #b9c9a9;
  background: #eef5e5;
  color: #5a6c45;
}

.club-board-metrics {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 10rpx;
}

.club-board-metrics__item {
  border-radius: 12rpx;
  background: #f8f3ea;
  padding: 10rpx;
  text-align: center;
}

.club-board-metrics__value {
  font-size: 30rpx;
  color: #2a2a2a;
  font-weight: 700;
}

.club-board-metrics__label {
  margin-top: 2rpx;
  display: block;
  font-size: 18rpx;
  color: #6b6b6b;
}

.club-board-list {
  margin-top: 10rpx;
  display: grid;
  gap: 8rpx;
}

.club-board-list__item {
  border-top: 1rpx solid #eee5d7;
  padding-top: 8rpx;
}

.club-board-list__title {
  font-size: 21rpx;
  color: #202020;
  font-weight: 600;
}

.club-board-list__meta {
  margin-top: 2rpx;
  display: block;
  font-size: 18rpx;
  color: #6a6a6a;
}

.collection-section__title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f1f1f;
  margin-bottom: 12rpx;
}

.badge-list {
  display: grid;
  gap: 10rpx;
}

.badge-card {
  border-radius: 16rpx;
  border: 2rpx solid #e0d0b0;
  background: #fff8ed;
  padding: 14rpx;
}

.badge-card__title {
  font-size: 25rpx;
  font-weight: 700;
  color: #52340f;
}

.badge-card__subtitle {
  margin-top: 4rpx;
  font-size: 21rpx;
  color: #6d4d26;
}

.badge-card__meta {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #8e6f44;
}

.badge-card__share {
  margin-top: 10rpx;
  height: 54rpx;
  line-height: 54rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 2rpx solid #c08a45;
  background: #ffffff;
  color: #6e4718;
  font-size: 21rpx;
}

.badge-card__share::after {
  border: 0;
}

.route-list {
  display: grid;
  gap: 12rpx;
}

.route-card {
  border-radius: 16rpx;
  border: 2rpx solid #e8e8e8;
  background: #ffffff;
  padding: 14rpx;
}

.route-card__header {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
}

.route-card__title {
  font-size: 24rpx;
  font-weight: 700;
  color: #191919;
}

.route-card__meta {
  font-size: 22rpx;
  color: #6a6a6a;
}

.route-card__track {
  margin-top: 8rpx;
  height: 10rpx;
  border-radius: 999rpx;
  background: #eee7dd;
  overflow: hidden;
}

.route-card__fill {
  height: 100%;
  background: linear-gradient(90deg, #f1b14f 0%, #f4ce89 100%);
}

.route-card__footer {
  margin-top: 10rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
}

.route-card__desc {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
  color: #555;
}

.route-card__share {
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d0d0d0;
  background: #fff;
  color: #444;
  font-size: 20rpx;
  padding: 0 16rpx;
}

.route-card__share::after {
  border: 0;
}

.route-card__compare {
  margin-top: 8rpx;
  font-size: 18rpx;
  color: #7a6a52;
}
