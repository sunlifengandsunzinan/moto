.me-upload-coming-card {
  margin-bottom: 20rpx;
}

.me-upload-coming-card__header {
  margin-bottom: 18rpx;
}

.me-upload-coming-card__body {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #F2E8DC;
}

.me-upload-coming-card__title {
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #47413C;
}