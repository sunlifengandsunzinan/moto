.privacy-page {
  padding: 28rpx 28rpx 44rpx;
  background: #ffffff;
  color: #1f1f1f;
  min-height: 100vh;
  box-sizing: border-box;
}

.privacy-title {
  text-align: center;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: 700;
  margin-top: 12rpx;
}

.privacy-date {
  text-align: center;
  margin-top: 20rpx;
  margin-bottom: 22rpx;
  color: #8f8f8f;
  font-size: 24rpx;
}

.privacy-section-title {
  font-size: 38rpx;
  line-height: 1.4;
  font-weight: 700;
  margin-top: 28rpx;
  margin-bottom: 14rpx;
}

.privacy-paragraph {
  font-size: 30rpx;
  line-height: 1.9;
  color: #2a2a2a;
}

.privacy-table {
  border: 1rpx solid #d9d9d9;
  border-radius: 10rpx;
  overflow: hidden;
  margin-top: 18rpx;
}

.privacy-row {
  display: flex;
  border-bottom: 1rpx solid #e5e5e5;
}

.privacy-row:last-child {
  border-bottom: 0;
}

.privacy-row--head {
  background: #f7f7f7;
}

.privacy-cell {
  font-size: 24rpx;
  line-height: 1.6;
  color: #2a2a2a;
  padding: 16rpx 10rpx;
  box-sizing: border-box;
}

.privacy-cell--info {
  width: 27%;
}

.privacy-cell--method {
  width: 27%;
}

.privacy-cell--purpose {
  width: 46%;
}