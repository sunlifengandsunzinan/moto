page {
  min-height: 100%;
  background:
    radial-gradient(circle at top left, rgba(215, 191, 161, 0.34), transparent 34%),
    radial-gradient(circle at top right, rgba(255, 251, 244, 0.9), transparent 26%),
    linear-gradient(180deg, #F9F3EA 0%, #EEE4D6 100%);
  color: #4F4A46;
  font-size: 28rpx;
}

.page-shell {
  padding: 24rpx 24rpx 40rpx;
}

.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.topbar-copy {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.eyebrow {
  font-size: 22rpx;
  color: #8A7A6B;
  letter-spacing: 0.12em;
}

.page-title {
  font-size: 52rpx;
  line-height: 1.18;
  font-weight: 700;
}

.topbar-action,
.button-primary,
.button-secondary,
.button-ghost {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
  padding: 0 28rpx;
  border-radius: 28rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.topbar-action,
.button-secondary {
  background: rgba(255, 250, 244, 0.9);
  color: #5B534D;
  border: 2rpx solid rgba(91, 83, 77, 0.12);
}

.button-primary {
  background: #4F4A46;
  color: #FBF7F0;
  border: 0;
}

.button-ghost {
  background: transparent;
  color: #5B534D;
  border: 2rpx solid rgba(91, 83, 77, 0.18);
}

.card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: rgba(255, 251, 245, 0.92);
  border: 2rpx solid rgba(91, 83, 77, 0.1);
  box-shadow: 0 24rpx 60rpx rgba(93, 83, 71, 0.1);
  box-sizing: border-box;
}

.card-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #47413C;
}

.card-desc,
.subtle,
.empty-text,
.error-text {
  color: #7B6F64;
  line-height: 1.6;
}

.inline-meta {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F2E8DC;
}

.inline-meta-label {
  font-size: 24rpx;
  color: #907F70;
}

.inline-meta-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #47413C;
  font-weight: 600;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.inline-badge {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #F2E8DC;
  color: #5E554E;
  font-size: 24rpx;
}

.actions-row,
.chip-row,
.tag-row,
.stats-grid,
.filter-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.chip-row,
.tag-row {
  margin-top: 18rpx;
}

.chip,
.tag {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  background: #EFE3D5;
  color: #675D56;
  font-size: 24rpx;
}

.chip-active,
.tag-accent {
  background: #4F4A46;
  color: #FBF7F0;
}

.stats-grid {
  margin-top: 20rpx;
}

.stat-item {
  flex: 1 1 calc(50% - 16rpx);
  min-width: 0;
  padding: 22rpx;
  border-radius: 24rpx;
  background: #F2E8DC;
  box-sizing: border-box;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A433E;
}

.stat-label {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8A7A6B;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  background: #FBF7F0;
  border: 2rpx solid rgba(91, 83, 77, 0.14);
  box-sizing: border-box;
}

.picker-label {
  font-size: 26rpx;
  color: #8B7C6D;
}

.picker-value {
  font-size: 28rpx;
  color: #4F4A46;
}

.list-column {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.list-card {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.list-card-header {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.list-card-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #162119;
}

.spot-image {
  width: 100%;
  height: 340rpx;
  border-radius: 28rpx 28rpx 0 0;
  display: block;
}

.spot-card {
  overflow: hidden;
  padding: 0;
}

.spot-card-body {
  padding: 24rpx;
}

.entry-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 24rpx 0;
  border-top: 2rpx solid rgba(31, 42, 34, 0.08);
}

.entry-row:first-child {
  padding-top: 0;
  border-top: 0;
}

.entry-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #162119;
}

.entry-arrow {
  font-size: 24rpx;
  color: #6A7A6E;
}

.loading,
.empty,
.error {
  padding: 48rpx 24rpx;
  text-align: center;
}