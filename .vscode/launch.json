{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Flask App",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Run Flask in Production Mode",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "APP_ENV": "production",
        "DEBUG": "false"
      }
    }
  ]
}